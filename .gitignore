# --- builds -------------------------------------------------------------
build/
build_*/
out/
cmake-build-*/

# --- portable toolchains (cmake/ninja binaries), keep build scripts -----
tools/
!tools/*.cmake

# --- thirdparty (vendored sources are tracked; big build dirs are not) --
thirdparty/JoltPhysics/
thirdparty/gns-build/
thirdparty/GameNetworkingSockets*/

# --- build artifacts ----------------------------------------------------
*.exe
*.dll
*.lib
*.a
*.o
*.obj
*.pdb
*.ilk
*.exp
*.zip
# Exception: authored Wavefront mesh assets (NOT compiler object files)
!assets/meshes/*.obj

# --- editor / tool runtime state ---------------------------------------
imgui.ini
*.log
*.tmp

# --- OS -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
